# PostgreSQL connection string for Prisma
# Format: postgresql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Replace with your local PostgreSQL 18 credentials (e.g. user postgres, your password, port 5432)
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/blogspace?schema=public"

# JWT signing secret for session tokens (must be at least 32 characters)
AUTH_SECRET="your_at_least_32_characters_secret_here"
